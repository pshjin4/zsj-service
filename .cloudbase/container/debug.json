{
  "containers": [
    {
      "name": "localserver",
      "ip": "127.0.0.1"
    },
    {
      "name": "wxcloudrun-springboot-main",
      "domain": "",
      "ip": "",
      "containerId": "97d72100835648169a2fced3034b593ba3f2812985d8b08fc656bd0cfc718ce6"
    }
  ],
  "config": {
    "wxcloudrun-springboot-main": {
      "containerPort": 80,
      "minNum": 0,
      "maxNum": 5,
      "cpu": 1,
      "mem": 2,
      "policyType": "cpu",
      "policyThreshold": 50,
      "policyDetails": [
        {
          "PolicyType": "cpu",
          "PolicyThreshold": 50
        },
        {
          "PolicyType": "mem",
          "PolicyThreshold": 50
        }
      ],
      "envParams": {
        "MYSQL_USERNAME": "",
        "MYSQL_PASSWORD": "",
        "MYSQL_ADDRESS": ""
      },
      "customLogs": "stdout",
      "dataBaseName": "springboot_demo",
      "executeSQLs": [
        "CREATE DATABASE IF NOT EXISTS springboot_demo;",
        "USE springboot_demo;",
        "CREATE TABLE IF NOT EXISTS `Counters` (`id` int(11) NOT NULL AUTO_INCREMENT, `count` int(11) NOT NULL DEFAULT 1, `createdAt` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, `updatedAt` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (`id`)) ENGINE = InnoDB DEFAULT CHARSET = utf8;"
      ]
    }
  }
}